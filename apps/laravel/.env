# Configuração de execução — seção 6 da especificação funcional.
# Este arquivo é versionado deliberadamente (seção 7 conta o .env versionado como código
# de configuração): o ambiente é um laboratório controlado, sem dados nem credenciais
# reais. As variáveis DB_* são sobrescritas pelo ambiente do contêiner.
APP_NAME=BookApi
APP_ENV=production
APP_KEY=base64:qNB3j6W+QxBxk/g0SeWCvVkMI+N2O9gZetzdkPD91Eo=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tccbench
DB_USER=bench
DB_PASSWORD=bench

# Cache de aplicação e sessão desabilitados (seção 6.1); a API é sem estado.
CACHE_STORE=null
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MAIL_MAILER=log
